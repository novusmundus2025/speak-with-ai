# Public base URL only. Never place a long-lived secret in a VITE_* variable.
VITE_MUNDUSX_API_URL=https://mundusx.ai

# Keep mock mode on until the MundusX conversation endpoint is available.
VITE_USE_MOCK_MUNDUSX=true

# Local German speech recognition. The multilingual model is downloaded once
# and cached by the client when mock mode is disabled.
VITE_USE_MOCK_TRANSCRIPTION=false
VITE_WHISPER_MODEL=onnx-community/whisper-tiny
